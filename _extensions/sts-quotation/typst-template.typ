#let sts-accent = rgb("15607A")
#let sts-tint = rgb("EDF3F5")
#let sts-rule = rgb("BBBBBB")

#let sts-svg(source, ..args) = image(bytes(source), format: "svg", ..args)

// 12000 -> "12,000"
#let sts-thousands(x) = {
  let digits = str(int(calc.round(x)))
  let n = digits.len()
  let out = ""
  for (i, c) in digits.clusters().enumerate() {
    if i > 0 and calc.rem(n - i, 3) == 0 { out += "," }
    out += c
  }
  out
}

// 3.0 -> "3", 2.5 -> "2.5", 3.3000000000000003 -> "3.3"; rounded to two
// decimals because sums of fractional days are inexact in floating point
#let sts-days(x) = {
  let r = calc.round(x, digits: 2)
  if r == calc.round(r) { str(int(r)) } else { str(r) }
}

// Packages-and-fees table, called by quotation.lua from the `fees` field of
// the YAML header. Each package has a name, an optional description and one
// value of days for each option; the fee is days times the daily rate.
// Without a rate, the table shows days only.
#let sts-fees(
  rate: none,
  options: (),
  packages: (),
  symbol: "€",
  currency: none,
  tax: [excluding taxes],
  note: none,
) = {
  let n = calc.max(options.len(), 1)
  let priced = rate != none
  // A text rate, such as "x,xxx", is a placeholder shown for every fee
  let money(x) = if type(rate) == str { symbol + rate } else { symbol + sts-thousands(x) }
  let fee(days) = if type(rate) == str { money(none) } else { money(days * rate) }
  let totals = range(n).map(i => packages.map(p => p.days.at(i)).sum(default: 0))

  // Days, or Days and Fee, for each option
  let per-option = if priced { 2 } else { 1 }
  let cells(d, strong: false) = {
    let fmt(x) = if strong { [*#x*] } else { [#x] }
    if priced { (fmt(sts-days(d)), fmt(fee(d))) } else { (fmt(sts-days(d)),) }
  }
  let labels = if priced { ([Days], [Fee]) } else { ([Days],) }

  let header = if options.len() > 0 {
    table.header(
      table.cell(rowspan: 2, align: left + horizon)[Package],
      ..options.map(o => table.cell(colspan: per-option)[#o]),
      ..range(n).map(_ => labels).flatten(),
    )
  } else {
    table.header([Package], ..labels)
  }
  let header-rows = if options.len() > 0 { 2 } else { 1 }
  let widths = if priced { (1.6cm, 1.9cm) } else { (2.4cm,) }

  block(width: 100%, above: 0.8em, below: 0.6em, {
    set text(size: 9pt)
    set par(spacing: 0.4em)
    table(
      columns: (1fr,) + widths * n,
      align: left + top,
      inset: (x: 5pt, y: 4pt),
      stroke: 0.5pt + black,
      fill: (_, y) => if y < header-rows { sts-tint },
      header,
      ..packages.map(p => (
        [*#p.name*#if p.description != none [ \ #p.description]],
        ..p.days.map(d => cells(d)).flatten(),
      )).flatten(),
      [Total],
      ..totals.map(t => cells(t, strong: true)).flatten(),
    )
  })

  if priced or note != none {
    block(above: 0.5em, below: 1em, text(size: 9pt, style: "italic")[
      #if priced [All amounts #if currency != none [in #currency, ]#tax, at a daily rate of #money(rate).]
      #if note != none { note }
    ])
  }
}

// Signature block: photo, name and role with the lockup, bio and contact
// details. The defaults are Adam's; each can be replaced from the YAML header.
#let sts-signature(
  name: [Dr Adam N. H. Smith],
  role: [Director],
  bio: [Adam is a statistician and marine ecologist with more than 20 years of experience in quantitative research, teaching and consulting. In 2023, he founded Sea Through Science Limited, which he now runs full time, providing statistical analysis and modelling to clients in New Zealand and internationally. He holds a PhD in Statistics from Massey University, where he was Senior Lecturer in Statistics for over a decade, and has worked as a statistician and fisheries scientist in New Zealand public-sector science agencies. He has published more than 60 peer-reviewed papers, including in _Nature_ and _Science_, spanning ecology, fisheries and statistical methodology, and has taught more than 20 intensive international courses in multivariate statistics since 2017.],
  address: [Red Beach, New Zealand],
  email: "adam@seathrough.science",
  web: "https://www.seathrough.science",
  linkedin: "https://www.linkedin.com/in/anhsmith/",
  github: "https://github.com/anhsmith",
  scholar: "https://scholar.google.com/citations?user=5OvrU9IAAAAJ",
) = {
  let sep = [#h(0.5em)·#h(0.5em)]
  let icon(source) = box(baseline: 15%, sts-svg(source, height: 0.9em))
  // "https://www.linkedin.com/in/anhsmith/" -> "in/anhsmith/"
  let tail(url, after) = {
    let parts = url.split(after)
    if parts.len() > 1 { parts.last() } else { url }
  }

  let links = ()
  if linkedin != none {
    links.push(link(linkedin)[#icon(sts-icon-linkedin) #tail(linkedin, "linkedin.com/")])
  }
  if github != none {
    links.push(link(github)[#icon(sts-icon-github) #tail(github, "github.com/")])
  }
  if scholar != none {
    links.push(link(scholar)[#icon(sts-icon-scholar) Google Scholar])
  }

  let contact = ()
  if email != none { contact.push(link("mailto:" + email, email)) }
  if web != none { contact.push(link(web, web.replace(regex("^https?://"), ""))) }

  block(breakable: false, above: 2em, width: 100%, {
    line(length: 100%, stroke: 0.6pt + sts-rule)
    v(0.6em)
    grid(
      columns: (3.1cm, 1fr),
      align: (left + horizon, left + top),
      sts-svg(sts-photo, width: 2.7cm),
      {
        set text(size: 8.5pt)
        set par(spacing: 0.5em, leading: 0.4em)
        grid(
          columns: (1fr, auto),
          align: (left + bottom, right + bottom),
          text(size: 9.5pt, weight: "bold", (name, role).filter(x => x != none).join(sep)),
          sts-svg(sts-lockup, width: 3.6cm),
        )
        v(0.2em)
        bio
        set text(size: 8pt, style: "italic")
        set par(spacing: 0.35em)
        if address != none { par(address) }
        if contact.len() > 0 { par(contact.join(sep)) }
        if links.len() > 0 { par(links.join(sep)) }
      },
    )
  })
}

#let sts-quotation(
  title: none,
  subtitle: none,
  client: none,
  date: none,
  purpose: none,
  font: "Calibri",
  paper: "a4",
  signature: (:),
  signature-off: false,
  body,
) = {
  set document(title: title) if title != none

  set page(
    paper: paper,
    margin: (top: 1.4cm, bottom: 1.4cm, x: 1.8cm),
    numbering: none,
  )

  set text(font: font, size: 10pt, lang: "en")
  set par(leading: 0.5em, spacing: 0.65em)

  show heading: it => block(
    above: 1.1em,
    below: 0.55em,
    sticky: true,
    text(size: if it.level == 1 { 11pt } else { 10pt }, weight: "bold", fill: sts-accent, it.body),
  )

  set list(marker: [–], indent: 0.3em, body-indent: 0.9em, spacing: 0.45em)
  set enum(indent: 0.3em, spacing: 0.45em)

  // Title banner
  grid(
    columns: (1fr, auto),
    align: (left + horizon, right + horizon),
    gutter: 1em,
    {
      if title != none { text(size: 15pt, weight: "bold", title) }
      if subtitle != none { linebreak(); text(size: 10.5pt, fill: sts-accent, subtitle) }
    },
    sts-svg(sts-lockup, width: 4.6cm),
  )
  v(0.3em)
  line(length: 100%, stroke: 0.6pt + sts-rule)

  // Prepared for ... · date · purpose
  let prepared = ()
  if client != none { prepared.push([Prepared for #client]) }
  if date != none { prepared.push(date) }
  if purpose != none { prepared.push(purpose) }
  if prepared.len() > 0 {
    block(above: 0.6em, below: 1em, text(size: 9pt, style: "italic", prepared.join([#h(0.5em)·#h(0.5em)])))
  }

  body

  if not signature-off { sts-signature(..signature) }
}
